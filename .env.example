# ── Supabase (required on Vercel) ─────────────────────────────
# Project URL and the *publishable* key (safe for browsers).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only — never prefix with NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=

# ── Upstash Redis (optional: shared rate limiting) ────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── App ───────────────────────────────────────────────────────
# Public base URL used in invite links / QR codes, e.g. https://shut10.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional but recommended: HMAC secret for guest session tokens.
# Falls back to a hash of SUPABASE_SECRET_KEY when unset.
SESSION_SECRET=

# Password for /admin (admin panel is disabled in production when unset).
ADMIN_PASSWORD=

# Local only: enables the dev panel on a production build (`next start`).
# Never set this on Vercel; dev tools are always off in VERCEL_ENV=production.
# SHUT10_DEV_TOOLS=1
